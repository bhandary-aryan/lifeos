# Copy to .env and fill in. NEVER commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-with-django.core.management.utils.get_random_secret_key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://lifeos:change-me@localhost:5432/lifeos
LIFEOS_SITE_NAME=LifeOS

# Uploaded images (hobbies / bucket list). Private: only served through an owner-checked view. Use persistent storage in production.
# LIFEOS_MEDIA_ROOT=/var/lib/lifeos/media

# Login throttling counters live in the cache. Default is per-process memory; use a shared cache with several workers.
# CACHE_URL=redis://localhost:6379/1
# Only when your reverse proxy OVERWRITES X-Forwarded-For (otherwise clients can spoof their address):
# LIFEOS_TRUST_X_FORWARDED_FOR=true

# Public base URL for links inside reminder emails
# LIFEOS_SITE_URL=https://lifeos.example.com

# Production only
# DJANGO_CSRF_TRUSTED_ORIGINS=https://lifeos.example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_PRELOAD=false
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=LifeOS <noreply@example.com>
