# Copy to .env and fill in. NEVER commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-with-django.core.management.utils.get_random_secret_key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://lifeos:change-me@localhost:5432/lifeos
LIFEOS_SITE_NAME=LifeOS

